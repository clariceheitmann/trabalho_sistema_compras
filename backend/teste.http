Content-Type: application/json

### =====================================================
### TESTE 2 - Criar usuário para realizar compras
### =====================================================

POST http://localhost:3000/usuario
Content-Type: application/json

{
    "nome": "João",
    "sobrenome": "Silva",
    "idade": 30,
    "email": "joao@email.com",
    "telefone": "11999999999",
    "endereco": "Rua das Flores",
    "cidade": "São Paulo",
    "estado": "SP"
}

